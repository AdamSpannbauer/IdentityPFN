{
  "_schema": {
    "description": "Benchmark manifest for IdentityPFN diagnostics.",
    "current_loader_notes": [
      "Only kind=single_table is currently supported by load_benchmarks.",
      "Top-level keys starting with _ are ignored by the loader.",
      "Paths are relative to benchmark_data/.",
      "Every current benchmark entry must point to one single-table CSV via file."
    ],
    "allowed_values": {
      "kind": {
        "single_table": "One benchmark table with an entity_id_column; equal IDs define entity clusters.",
        "two_table": "Reserved for future two-table linkage input.",
        "multi_table": "Reserved for future multi-table/entity graph input."
      },
      "text_profile": {
        "none": "No meaningful text-like fields.",
        "short_fields": "Mostly short names, identifiers, locations, or compact labels.",
        "long_or_semantic_text": "Contains titles, descriptions, abstracts, bios, reviews, or other multi-token semantic text.",
        "mixed": "Contains both short fields and at least one longer semantic text field."
      },
      "field_types": {
        "text": "Free text or string value embedded by the text backend.",
        "categorical": "Discrete category encoded with learned category embeddings.",
        "numeric": "Numeric value normalized within table and column.",
        "date": "Parseable date encoded with year/month/day/weekday components.",
        "identifier": "Identifier-like string routed through text embedding but marked semantically.",
        "email": "Email-like identifier with optional normalization.",
        "phone": "Phone-like identifier with optional normalization."
      }
    },
    "required_keys_by_kind": {
      "single_table": [
        "kind",
        "description",
        "file",
        "entity_id_column",
        "field_types"
      ]
    },
    "single_table_input_keys": {
      "file": "Required path to one CSV file relative to benchmark_data/."
    },
    "optional_keys": {
      "short_description": "Brief table-ready benchmark description.",
      "text_profile": "Semantic profile of the benchmark's text fields.",
      "ignored_columns": "Columns documented as intentionally excluded from model input.",
      "entity_sample": "Deterministic entity-level sampling configuration."
    },
    "entity_sample": {
      "n_entities": "Positive integer number of entity clusters to sample.",
      "seed": "Integer deterministic sampling seed.",
      "require_positive_pairs": "Boolean; if true, keep only clusters with at least two records.",
      "require_variation": "Boolean; if true, keep only clusters with non-identical records across selected model-input fields."
    }
  },
